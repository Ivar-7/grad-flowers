rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public flowers catalog: anyone can read, only authenticated staff/admin can modify
    match /flowers/{flowerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Categories: public read, authenticated write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profiles: owner only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User orders: owner only
    match /users/{userId}/orders/{orderId} {
      allow read, write: if isOwner(userId);
    }

    // General orders (guest & authenticated delivery dispatches)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
    }
  }
}
