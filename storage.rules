rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public flower images: public read, authenticated staff/admin upload
    match /flowers/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // QR Message Card voice and video recordings
    match /qr-messages/{messageId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(audio|video)/.*');
    }

    // User uploads
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
